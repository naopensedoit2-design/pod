# ------------------------------------------------------------------
# Copie para .env.local (desenvolvimento) ou cadastre na Vercel
# (Settings → Environment Variables). NUNCA coloque chaves no Git.
# ------------------------------------------------------------------

# Banco Postgres (Neon, Supabase, Vercel Postgres...). Obrigatório.
DATABASE_URL=postgres://usuario:senha@host:5432/banco?sslmode=require

# Segredo para assinar a sessão do painel (32+ caracteres aleatórios). Obrigatório.
# Gere com: openssl rand -base64 32
AUTH_SECRET=

# Primeiro acesso ao painel: enquanto não existir nenhum administrador,
# entrar com estes dados cria a conta. Depois troque a senha em "Minha conta".
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Endereço público da loja (sem barra no final). Usado em e-mails, webhooks e retorno do pagamento.
NEXT_PUBLIC_SITE_URL=https://www.sualoja.com.br

# --- InfinitePay (pagamentos) ---------------------------------------
# A InfiniteTag (handle) pode ser definida aqui ou no painel (Configurações → Integrações).
INFINITEPAY_HANDLE=
# API Key do Checkout Integrado (começa com inchk_). Habilita desconto no Pix,
# parcelas sem juros assumidas pela loja e links de pagamento de uso único.
INFINITEPAY_API_KEY=

# --- YouDraw (produção sob demanda) ---------------------------------
# Chave yd_live_... com os escopos: catalog:read, artworks:write, products:write,
# shipping:quote, orders:write, orders:read (+ payments:write/read se o Pix for liberado).
YOUDRAW_API_KEY=
# Segredo whsec_... do webhook cadastrado no painel da YouDraw.
YOUDRAW_WEBHOOK_SECRET=
# Prefixo da referência do pedido enviada à YouDraw (ex.: LENTO-1001).
ORDER_REF_PREFIX=LENTO

# --- E-mails (escolha um) ------------------------------------------
# Opção simples, sem domínio: um Gmail da loja com "senha de app"
# (myaccount.google.com/apppasswords — exige verificação em 2 etapas).
SMTP_USER=
SMTP_PASS=
# Nome que aparece como remetente quando usa SMTP_USER.
EMAIL_FROM_NAME=LENTO
# Com domínio próprio: Resend (recomendado) ou qualquer SMTP por URL.
RESEND_API_KEY=
SMTP_URL=
EMAIL_FROM="LENTO <contato@sualoja.com.br>"
# Para onde vão os avisos de novos pedidos (padrão: e-mail da empresa no painel).
ADMIN_NOTIFY_EMAIL=

# --- Reconciliação diária (Vercel Cron) ----------------------------
CRON_SECRET=

# --- Testes ----------------------------------------------------------
# Com "true" e sem InfinitePay configurada, o pagamento é simulado.
# NUNCA ligue em produção.
PAYMENTS_TEST_MODE=false
# Em um banco novo, cria produtos de demonstração (padrão: true).
SEED_DEMO=true
